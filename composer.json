{
    "require": {
        "twig/twig": "^3.1",
        "symfony/console": "^7.4",
        "nesbot/carbon": "^3.6",
        "vlucas/phpdotenv": "^5.6",
        "symfony/finder": "^7.1",
        "nikic/fast-route": "^1.3",
        "nunomaduro/termwind": "^2.0",
        "monolog/monolog": "^3.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "symfony/mailer": "^7.1",
        "symfony/sendgrid-mailer": "^7.4",
        "ext-mbstring": "*",
        "ext-ffi": "*",
        "ext-swoole": "*",
        "cydrickn/socketio": "^1.6",
        "giggsey/libphonenumber-for-php": "^8.13",
        "filp/whoops": "^2.16",
        "symfony/uid": "^7.2",
        "voku/portable-ascii": "^2.0",
        "doctrine/sql-formatter": "^1.5",
        "league/commonmark": "^2.6",
        "psr/container": "^2.0",
        "symfony/mailtrap-mailer": "^7.2",
        "league/flysystem": "^3.0",
        "elasticsearch/elasticsearch": "^9.0",
        "intervention/image": "^3.11",
        "nikic/php-parser": "^5.5",
        "godruoyi/php-snowflake": "^3.2",
        "zircote/swagger-php": "^5.1",
        "psr/simple-cache": "^3.0",
        "ext-intl": "*",
        "dompdf/dompdf": "^3.1",
        "phpoffice/phpspreadsheet": "^5.1",
        "league/flysystem-aws-s3-v3": "^3.0",
        "php-amqplib/php-amqplib": "^3.7",
        "ext-zip": "*",
        "symfony/http-client": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Ryra\\Core\\": "core"
        },
        "files": [
            "./core/autoload_modules.php"
        ]
    },
    "require-dev": {
        "symfony/var-dumper": "^7.1",
        "phpunit/phpunit": "^12.5",
        "pestphp/pest": "^4.6",
        "swoole/ide-helper": "^5.1"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    }
}
